*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#09090b;color:#f5f5f5;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden}
button,input,textarea{font:inherit}
.noise{position:fixed;inset:0;pointer-events:none;opacity:.04;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
.topbar{max-width:1100px;margin:auto;padding:22px 20px;display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:1000;letter-spacing:-1px;font-size:22px}.logo span{color:#ff3b30}
.badge,.stamp{font-size:11px;font-weight:900;border:1px solid #333;border-radius:999px;padding:7px 11px;color:#aaa}
.hero{max-width:900px;margin:55px auto 35px;padding:0 20px;text-align:center}
.eyebrow{font-size:11px;font-weight:900;letter-spacing:2px;color:#ff574f;margin:0 0 14px}
.hero h1{font-size:clamp(50px,11vw,112px);line-height:.82;letter-spacing:-6px;margin:0;font-weight:1000}
.hero h1 span{color:#ff3b30}
.sub{max-width:560px;margin:28px auto 0;color:#a1a1aa;font-size:16px;line-height:1.6}
.card,.result{max-width:900px;margin:0 auto 70px;padding:30px;border:1px solid #27272a;background:#111114;border-radius:26px;box-shadow:0 20px 70px #0008}
.step{padding:4px 0 34px}.step:last-of-type{padding-bottom:25px}
.step-head{display:flex;gap:12px;align-items:flex-start;margin-bottom:17px}
.step-head>span{font-size:11px;color:#ff4d45;font-weight:900;border:1px solid #3a2020;border-radius:8px;padding:5px 7px;flex:none}
.step-head h2{font-size:19px;margin:0;line-height:1.3}.step-head em{font-style:normal}
.hint{color:#888;margin:5px 0 0;font-size:13px;line-height:1.4}.hint b{color:#ff574f}
.upload{height:240px;border:2px dashed #39393d;border-radius:20px;display:flex;align-items:center;justify-content:center;text-align:center;cursor:pointer;overflow:hidden;position:relative;background:#0c0c0f;transition:.2s}
.upload:hover{border-color:#ff3b30}.upload input{display:none}.upload-icon{font-size:42px;margin-bottom:10px}
.upload strong{display:block}.upload small{color:#777;display:block;margin-top:5px}.upload img{display:none;width:100%;height:100%;object-fit:cover}
.upload.has-photo #uploadContent{display:none}.upload.has-photo #preview{display:block}
.remove-photo{display:none;position:absolute;top:10px;right:10px;width:34px;height:34px;border:0;border-radius:50%;background:#09090dcc;color:#fff;font-size:25px;line-height:1;cursor:pointer;z-index:2}
.upload.has-photo .remove-photo{display:block}
.modes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.modes button,.actions button{background:#17171b;color:#eee;border:1px solid #29292e;border-radius:15px;padding:15px;text-align:left;cursor:pointer;transition:.18s}
.modes button:hover{border-color:#555}.modes button.selected{border-color:#ff3b30;background:#201112;box-shadow:0 0 0 1px #ff3b30 inset}
.modes b{display:block;font-size:14px}.modes small{color:#777;display:block;margin-top:5px}
.questions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.question-card{min-width:0;background:#141418;border:1px solid #29292e;border-radius:16px;padding:15px;transition:.18s;overflow:hidden}
.question-card.selected{border-color:#ff3b30;background:#1b1112;box-shadow:0 0 0 1px #ff3b30 inset}
.question-top{display:flex;gap:10px;align-items:flex-start;cursor:pointer}
.question-check{width:23px;height:23px;border:1px solid #444;border-radius:7px;display:grid;place-items:center;flex:none;color:transparent;font-size:14px;font-weight:900}
.question-card.selected .question-check{background:#ff3b30;border-color:#ff3b30;color:#fff}
.question-text{font-size:13px;line-height:1.45;font-weight:800;overflow-wrap:anywhere}
.question-card textarea{display:block;width:100%;max-width:100%;min-width:0;min-height:0;height:0;box-sizing:border-box;opacity:0;overflow:hidden;background:#09090b;border:0;color:#fff;border-radius:11px;padding:0;resize:vertical;outline:none;transition:height .18s ease,opacity .18s ease,padding .18s ease,margin .18s ease}
.question-card.selected textarea{height:78px;opacity:1;padding:11px;margin-top:12px;border:1px solid #34343a;overflow:auto}
.question-card textarea:focus{border-color:#ff3b30}
.cook{width:100%;border:0;border-radius:16px;background:#ff3b30;color:white;font-size:18px;font-weight:1000;padding:18px;cursor:pointer;box-shadow:0 8px 30px #ff3b3033;transition:.2s}
.cook:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 12px 35px #ff3b3055}
.cook:disabled{opacity:.32;cursor:not-allowed;box-shadow:none}.cook span{float:right}
.status{text-align:center;color:#777;font-size:12px;min-height:18px;margin:12px 0 0}.status.ready{color:#ff6b63;font-weight:800}
.tiny{text-align:center;color:#555;font-size:11px;margin:9px 0 0}
.hidden{display:none}
.result-top{display:flex;justify-content:space-between;align-items:center}.result-photo-wrap{width:130px;height:130px;border-radius:50%;overflow:hidden;border:5px solid #ff3b30;margin:25px auto 10px}
.result-photo-wrap img{width:100%;height:100%;object-fit:cover}.result h2{text-align:center;font-size:34px;margin:12px 0 25px;letter-spacing:-1px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.stat{background:#18181c;border-radius:13px;padding:13px;text-align:center}
.stat label{font-size:10px;color:#777;display:block;font-weight:800}.stat strong{font-size:21px}
.roast-box,.final-box{background:#0b0b0e;border:1px solid #28282d;border-radius:18px;padding:20px;margin-top:16px}
.roast-label{font-size:10px;color:#ff574f;font-weight:900;letter-spacing:1.5px;margin-bottom:13px}.roast-box #roastText{font-size:17px;line-height:1.7;overflow-wrap:anywhere}
.final-box{text-align:center;font-size:20px;font-weight:900}.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:16px}.actions button{text-align:center;font-weight:800}
.disclaimer{font-size:10px;color:#555;text-align:center;margin:18px 0 0}footer{text-align:center;color:#3f3f46;font-size:10px;font-weight:800;padding:20px 20px 50px;letter-spacing:1px}
@media(max-width:650px){.hero{margin-top:35px}.hero h1{letter-spacing:-3px}.card,.result{margin:0 12px 45px;padding:20px;border-radius:20px}.modes,.questions{grid-template-columns:1fr}.topbar{padding:18px 14px}.badge{font-size:9px}.question-card textarea{font-size:14px}.stats{grid-template-columns:repeat(2,1fr)}.result h2{font-size:27px}.actions{grid-template-columns:1fr}}
